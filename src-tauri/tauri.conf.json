{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Payment Reconciliation",
  "version": "0.1.0",
  "identifier": "com.paymentreconciliation.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Payment Reconciliation",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/python/**/*",
      "../backend/app/**/*",
      "../backend/config/**/*",
      "../backend/requirements.txt",
      "../run_production.py"
    ],
    "publisher": "Payment Reconciliation Team",
    "copyright": "Copyright © 2026 Payment Reconciliation Team. All rights reserved.",
    "category": "Finance",
    "shortDescription": "Local-first Payment Screenshot and Bank Statement Reconciliation Desktop Application",
    "longDescription": "Automated local-first payment screenshot scanning, multi-provider OCR extraction, bank statement import, and deterministic transaction reconciliation engine.",
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "csv",
          "xlsx"
        ],
        "name": "Bank Statement",
        "role": "Viewer"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp"
        ],
        "name": "Payment Screenshot",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQzNDRjg0Nzk0OEQxMDYCUlRXSmQ5eXZwYndDclVHQXZyZWhmYUpKSUhDUVdqTkpvRWJCYklnb1Vxb1p3Tjl1dDkrSUpSdUcK",
      "endpoints": [
        "https://releases.example.com/payment-reconciliation/{{target}}/{{current_version}}"
      ]
    }
  }
}