APP_NAME="Payment & Bank Statement Reconciliation API"
APP_VERSION="0.1.0"
APP_ENV="production"
DEBUG=False

# Server Port (Render sets $PORT automatically)
PORT=10000

# Database URL:
# For SQLite on Render Persistent Disk: sqlite:///./data/reconciliation.db
# For PostgreSQL on Render: postgresql://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./data/reconciliation.db"

# CORS Allowed Origins (Comma-separated or JSON list)
# Include Tauri production & development protocols:
CORS_ORIGINS="https://tauri.localhost,tauri://localhost,http://tauri.localhost,http://localhost:1420,http://localhost:5173"

# Storage Directories (Optional overrides)
# APP_DATA_DIR="./data"
# SCREENSHOTS_DIR="./data/payment-screenshots"
# STATEMENTS_DIR="./data/account-statements"

# OCR Provider Settings (paddle, tesseract)
# Default is 'paddle' for local offline processing (no external API keys required)
OCR_PROVIDER="paddle"
PADDLE_LANGUAGE="en"
TESSERACT_PATH=""


